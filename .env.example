# Noctis — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to Git.

# Supabase (Client-side & Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Supabase (Server-side / Admin only — NEVER expose to client or prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Web Push / VAPID (required for push notifications)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is exposed to browser PushManager. VAPID_PUBLIC_KEY can also be read on server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY is server-only. NEVER expose to client or prefix with NEXT_PUBLIC_!
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@noctis.app

# Reminder Scheduler (secret for cron endpoint)
REMINDER_SCHEDULER_SECRET=
